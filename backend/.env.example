# ============================================================
# Configuração da API (copie para .env:  cp .env.example .env)
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).
# ============================================================

# --- Segurança / JWT ---------------------------------------
# Chave usada para assinar os tokens. Gere uma aleatória com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-uma-chave-aleatoria-grande
JWT_ALGORITMO=HS256
# Tempo de validade do token, em minutos
JWT_EXPIRA_MINUTOS=120

# --- Banco de dados (SQLite) -------------------------------
# Arquivo onde ficam usuários, conversas e mensagens.
# Caminho relativo à pasta backend/. Sobrevive ao reinício da API.
DATABASE_PATH=data/chat.db

# --- Modelo de linguagem -----------------------------------
# simulado -> respostas por regra, não precisa de chave (padrão)
# gemini   -> API gratuita do Google Gemini (preencha GEMINI_API_KEY)
# offline  -> modelo sempre indisponível (para demonstrar o erro 503)
LLM_PROVIDER=simulado

# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Tempo máximo (s) esperando o modelo responder
LLM_TIMEOUT=30

# --- CORS --------------------------------------------------
CORS_ORIGINS=http://localhost:8501
